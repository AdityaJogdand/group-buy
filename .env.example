# Copy to .env and fill in. Never commit .env.
# PayPal REST app credentials, SANDBOX (developer.paypal.com → Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Any OpenAI-compatible chat endpoint. We use Groq: https://api.groq.com/openai/v1 + openai/gpt-oss-120b
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Sandbox personal (buyer) account, used only by the automated tests to approve holds
PAYPAL_BUYER_EMAIL=
PAYPAL_BUYER_PASSWORD=
# Webhook id from developer.paypal.com → your app → Webhooks (URL: <backend>/paypal/webhook)
PAYPAL_WEBHOOK_ID=
# Optional
# SELLER_KEY=      protects the seller dashboard API; open /seller?key=… once
# CLOCK_SPEED=     demo clock: 4320 turns 3 days into 60 s
# WEB_URL / BASE_URL / HOST / PORT / DB_PATH   deploy settings (see render.yaml)
